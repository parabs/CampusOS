<?xml version="1.0" encoding="UTF-8"?>
<programs>
    <!-- Bachelor of Science in Information Technology (B.Sc IT) -->
    <program id="bsit">
        <title>Bachelor of Science in IT (B.Sc IT)</title>
        <shortTitle>B.Sc IT</shortTitle>
        <code>BSCIT</code>
        <level>Undergraduate (UG)</level>
        <courseType>Bachelor Degree</courseType>
        <duration>3 Years</duration>
        <durationISO>P3Y</durationISO>
        <intake>120 Seats</intake>
        <nep>NEP 2020 Aligned</nep>
        <nepBadge>AI Integrated</nepBadge>
        <rating>4.85 Rating</rating>
        <placementRate>97%</placementRate>
        <avgSalary>₹7.5 LPA</avgSalary>
        <highSalary>₹14.0 LPA</highSalary>
        <eligibility>10+2 with Math (45%+)</eligibility>
        
        <eligibilityDetails>
            <eligibilityDetail>Passed Standard XII (HSC) or equivalent examination from a recognized board.</eligibilityDetail>
            <eligibilityDetail>Mathematics must be secured as a compulsory subject at the Higher Secondary level.</eligibilityDetail>
            <eligibilityDetail>Minimum aggregate score of 45% for Open Category and 40% for Reserved Category candidates.</eligibilityDetail>
        </eligibilityDetails>

        <description>Cutting-edge technical curriculum covering software engineering, cloud workflows, and data structures.</description>
        <overview>The Bachelor of Science in Information Technology (B.Sc IT) programme is designed to provide comprehensive theoretical and practical foundations in computing, modern software development, cloud infrastructure, and data architecture. Aligned with NEP 2020 framework, the curriculum integrates real-world programming labs, AI workflows, and collaborative capstone projects.</overview>
        
        <!-- Curriculum Nodes -->
        <semester name="Year 1 • Semester I">
            <course>
                <name>Imperative Programming</name>
                <code>BSIT101</code>
                <credits>4 Credits</credits>
            </course>
            <course>
                <name>Digital Logic and Applications</name>
                <code>BSIT102</code>
                <credits>4 Credits</credits>
            </course>
            <course>
                <name>Discrete Mathematics</name>
                <code>BSIT103</code>
                <credits>4 Credits</credits>
            </course>
        </semester>
        <semester name="Year 1 • Semester II">
            <course>
                <name>Object Oriented Programming</name>
                <code>BSIT201</code>
                <credits>4 Credits</credits>
            </course>
            <course>
                <name>Microprocessor Architecture</name>
                <code>BSIT202</code>
                <credits>4 Credits</credits>
            </course>
            <course>
                <name>Web Design and Client-Side Scripting</name>
                <code>BSIT203</code>
                <credits>4 Credits</credits>
            </course>
        </semester>

        <!-- Faculty Nodes -->
        <facultyMember>
            <name>Dr. Rajesh Sharma</name>
            <designation>Professor &amp; Head of Department</designation>
            <qualification>Ph.D. in Computer Science, IIT Bombay</qualification>
        </facultyMember>
        <facultyMember>
            <name>Prof. Sneha Kulkarni</name>
            <designation>Associate Professor</designation>
            <qualification>M.Tech in Software Engineering</qualification>
        </facultyMember>

        <!-- Outcome Nodes -->
        <outcome>
            <title>Technical Knowledge &amp; Coding Proficiency</title>
            <description>Master multiple high-level programming paradigms, database management systems, and advanced software engineering lifecycles.</description>
        </outcome>
        <outcome>
            <title>System Design &amp; Cloud Workflows</title>
            <description>Architect scalable, secure cloud-native applications and deploy containerized microservices across enterprise environments.</description>
        </outcome>

        <!-- Career Roles -->
        <careerRole>Software Developer</careerRole>
        <careerRole>Web Developer</careerRole>
        <careerRole>Cloud Engineer</careerRole>
        <careerRole>Database Administrator</careerRole>
        <careerRole>Cybersecurity Analyst</careerRole>
        <careerRole>IT Consultant</careerRole>

        <tuitionFee>₹34,000</tuitionFee>
        <devFee>₹6,000</devFee>
        <libFee>₹2,500</libFee>
        <totalFee>₹42,500</totalFee>
    </program>

    <!-- Bachelor of Management Studies (BMS) -->
